{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:diagnose:case:v1",
  "title": "Diagnose CASE v1 record",
  "$comment": "This schema documents record structure only. Date-time fields use RFC3339 with an explicit timezone. It does not prove evidence truth, command execution, causal validity, or append history.",
  "oneOf": [
    { "$ref": "#/$defs/header" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["schema", "schema_version", "analysis_version", "record_type", "case_id", "created_at"],
      "properties": {
        "schema": { "const": "diagnose.case" },
        "schema_version": { "const": 1 },
        "analysis_version": { "const": 1 },
        "record_type": { "const": "case_header" },
        "case_id": { "type": "string", "minLength": 1 },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "record_type",
        "case_id",
        "sequence",
        "timestamp",
        "payload"
      ],
      "properties": {
        "schema": { "const": "diagnose.case" },
        "schema_version": { "const": 1 },
        "record_type": {
          "enum": [
            "oracle",
            "capability",
            "reproduction",
            "hypothesis",
            "probe",
            "control",
            "falsification",
            "terminal"
          ]
        },
        "case_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
